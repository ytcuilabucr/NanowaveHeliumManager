# Copy to .env (never committed) and fill in. Real environment variables take precedence.

# Console port (8080 is taken by another web server on the lab PC)
HR_UI_PORT=8090

# Instrument IP addresses (required)
HR_PUMP_HOST=
# ATL1,ATL2,ATL3, comma separated
HR_ATL_HOSTS=
HR_JANIS_HOST=

# ATL liquefiers (web page login)
HR_ATL_USER=
HR_ATL_PASSWORD=

# Janis LHe level meter (HTTP Basic auth)
JANIS_USERNAME=
JANIS_PASSWORD=

# Safety: writes to the hardware are refused unless set to 1
HR_PUMP_ALLOW_WRITES=0
HR_ATL_ALLOW_WRITES=0
HR_VALVE_ALLOW_WRITES=0

# Google status / log sheets (Apps Script web app from apps_script/HeliumStatus.gs)
HR_STATUS_SHEET_URL=
HR_STATUS_SHEET_TOKEN=
HR_GAS_DEPLOYMENT_ID=
# HR_STATUS_INTERVAL=30
# HR_LOG_INTERVAL=180

# CMI / Wei-He3 levels: spreadsheet id and tab gids (read through the web app above; off when unset)
HR_CRYO_SHEET_ID=
HR_CMI_GID=
HR_WEI_GID=

# Slack alerts: bot token (xoxb-...), channel ID (C...), member IDs @mentioned on critical alerts
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
HR_SLACK_MANAGERS=
# instruments switched off at first start: pump, atl1, atl2, atl3, janis, cmi, wei, valve
# (afterwards the Internal tab toggles are kept in state/modes.json)
HR_ALERT_ARCHIVED=atl2,wei,janis
HR_REPORT_TIME=22:00
HR_REPORT_HORIZON=08:00

# Optional overrides (defaults shown)
# HR_PUMP_INTERVAL=0.2
# HR_ATL_INTERVAL=10
# HR_JANIS_INTERVAL=180
# HR_STEP2_DELAY=5
# HR_UI_HOST=0.0.0.0

# Legacy Sheets upload (only if used)
# HR_SHEETS_URL=

# Notion ATL log (uv run heliumrecovery log-atl --notion)
NOTION_TOKEN=
NOTION_ATL_STATUS_DB=
NOTION_ATL_LOG_DB=
NOTION_ATL_PAGE=
